{
  "opencollection": "1.0.0",
  "info": {
    "name": "AppOmni SaaS Security Compliance API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Compliance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AppOmni - List Compliance Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.appomni.com/v1/compliance/reports"
          },
          "docs": "Returns a list of compliance reports generated by AppOmni"
        }
      ]
    }
  ],
  "bundled": true
}