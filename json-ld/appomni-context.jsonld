{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "appomni": "https://appomni.com/vocab#",
    "id": "@id",
    "finding_id": { "@id": "appomni:finding", "@type": "@id" },
    "identity_hash": "appomni:identityHash",
    "description": "schema:description",
    "status": "appomni:status",
    "detailed_status_name": "appomni:detailedStatusName",
    "detailed_status_label": "appomni:detailedStatusLabel",
    "reasons": "appomni:reasons",
    "context": "appomni:subjectContext",
    "appomni_risk_level": "appomni:riskLevel",
    "appomni_risk_score": "appomni:riskScore",
    "policy_id": { "@id": "appomni:policy", "@type": "@id" },
    "monitored_service_id": { "@id": "appomni:monitoredService", "@type": "@id" },
    "monitored_service_name": "schema:name",
    "monitored_service_tags": "appomni:tags",
    "monitored_service_owner": "schema:owner",
    "compliance_controls": "appomni:complianceControls",
    "compliance_frameworks": "appomni:complianceFrameworks",
    "external_ticket_data": "appomni:externalTickets",
    "assignee": "schema:agent",
    "num_occurrences_open": "appomni:openOccurrenceCount",
    "num_occurrences_closed": "appomni:closedOccurrenceCount",
    "first_opened": "schema:startDate",
    "last_opened": "appomni:lastOpened",
    "last_closed": "schema:endDate",
    "last_scanned": "appomni:lastScanned",
    "count": "schema:totalItems",
    "next": { "@id": "schema:nextItem", "@type": "@id" },
    "previous": { "@id": "schema:previousItem", "@type": "@id" },
    "results": "schema:itemListElement"
  },
  "@comment": "Derived 2026-09-04 from the real Finding and Occurrence response bodies in AppOmni's public Postman collection, https://api.appomni.com/. Replaces a context built on a fabricated SecurityEvent model."
}
